---
import '../styles/global.css'
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { buildWebSiteJsonLd, buildOrganizationJsonLd } from '../lib/schema'

interface Props {
  title: string
  description: string
  image?: string
  // A mesma pagina nos outros idiomas. Alimenta o seletor de idioma e, quando
  // ha mais de um idioma, os <link rel="alternate" hreflang>.
  alternateUrl?: Partial<Record<'pt-BR' | 'en', string>>
  // false = usa alternateUrl so no seletor, sem declarar hreflang. Para pagina
  // cujo par existe mas nao deve ser indexado.
  hreflang?: boolean
  // Pagina rasa: sai com noindex (mantendo follow) e sem hreflang.
  noindex?: boolean
}

const { title, description, image, alternateUrl, hreflang = true, noindex = false } = Astro.props
const lang = getLangFromUrl(Astro.url)
const canonical = new URL(Astro.url.pathname, Astro.site).toString()

// hreflang so com par de verdade: declaracao de um idioma so e ignorada.
// x-default aponta pro pt-BR, mesma convencao do site institucional.
const alternates = Object.entries(alternateUrl ?? {}).map(
  ([l, url]) => [l, new URL(url, Astro.site).toString()] as const,
)
const emitHreflang = hreflang && !noindex && alternates.length > 1
const xDefault = alternates.find(([l]) => l === 'pt-BR')?.[1]
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <!-- Tema antes do primeiro paint. Precisa ser is:inline (script de
         componente Astro e deferido e chega tarde demais: flash escuro para
         quem le no claro). O try/catch cobre localStorage bloqueado. -->
    <script is:inline>
      try {
        var stored = localStorage.getItem('precisian-blog-theme')
        var light = stored ? stored === 'light' : window.matchMedia('(prefers-color-scheme: light)').matches
        if (light) document.documentElement.classList.add('light')
      } catch (e) {}
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/blog/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`Precisian Blog (${lang})`} href={`/blog/${lang}/rss.xml`} />

    <!-- Site-wide structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(buildWebSiteJsonLd())} />
    <script type="application/ld+json" set:html={JSON.stringify(buildOrganizationJsonLd())} />

    <!-- Fonts: Inter (body), Sora (display), JetBrains Mono (code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&family=Sora:wght@400;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&family=Sora:wght@400;600;700;800&display=swap"
    />

    {emitHreflang && alternates.map(([l, url]) => (
      <link rel="alternate" hreflang={l} href={url} />
    ))}
    {emitHreflang && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'pt-BR' ? 'pt_BR' : 'en_US'} />
    {image && <meta property="og:image" content={image} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <slot name="head" />
  </head>
  <body class="bg-bg-base text-fg font-sans antialiased min-h-screen flex flex-col">
    <Header alternateUrl={alternateUrl} />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
