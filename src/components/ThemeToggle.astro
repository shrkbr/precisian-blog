---
// precisian-blog/src/components/ThemeToggle.astro
//
// A APLICACAO do tema NAO mora aqui: ela roda no script inline do <head> do
// BaseLayout, antes do primeiro paint. Se ficasse neste componente (que o Astro
// empacota como modulo deferido), quem le no modo claro veria um flash escuro
// a cada pagina. Aqui fica so o clique.
//
// O icone tambem nao e trocado por JS — os dois ficam no HTML e o CSS esconde
// um, senao o glifo errado aparece ate o script rodar.
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<button
  id="theme-toggle"
  type="button"
  aria-label={t('nav.theme')}
  title={t('nav.theme')}
  class="theme-toggle text-fg-muted hover:text-accent transition-colors p-1 -m-1"
>
  <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  /* Escuro (padrao): oferece o sol, que e para onde o clique leva. */
  .theme-toggle .icon-moon { display: none; }
  :global(:root.light) .theme-toggle .icon-sun { display: none; }
  :global(:root.light) .theme-toggle .icon-moon { display: block; }
</style>

<script>
  const STORAGE_KEY = 'precisian-blog-theme'
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light')
    try {
      localStorage.setItem(STORAGE_KEY, isLight ? 'light' : 'dark')
    } catch {
      // localStorage bloqueado (janela anonima): o tema vale so nesta pagina.
    }
  })
</script>
