---
// precisian-blog/src/components/LanguageSwitcher.astro
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import { languages, type Lang } from '../i18n/ui'

// No mobile o rotulo e abreviado: "Portugues"/"English" por extenso faziam a
// nav do header quebrar numa terceira linha a 375px.
const shortLabels: Record<Lang, string> = { 'pt-BR': 'PT', en: 'EN' }

interface Props {
  alternateUrl?: Partial<Record<Lang, string>>
}

const { alternateUrl = {} } = Astro.props
const currentLang = getLangFromUrl(Astro.url)
const t = useTranslations(currentLang)
---

<nav aria-label="Language" class="flex gap-3 text-sm">
  {(Object.keys(languages) as Lang[]).map((lang) => {
    const isCurrent = lang === currentLang
    const href = alternateUrl[lang] ?? `/blog/${lang}/`
    return (
      <a
        href={href}
        class:list={[
          'hover:text-accent-hover',
          isCurrent ? 'text-accent font-semibold' : 'text-fg-muted',
        ]}
        aria-current={isCurrent ? 'page' : undefined}
        lang={lang}
      >
        <span class="sm:hidden">{shortLabels[lang]}</span>
        <span class="hidden sm:inline">{languages[lang]}</span>
      </a>
    )
  })}
</nav>
